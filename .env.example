# Copy to .env next to docker-compose.yml and adjust.

# Public hostname. Caddy obtains a Let's Encrypt certificate for it.
# Use "localhost" for a local test (self-signed certificate).
ALCOVE_DOMAIN=alcove.example.com

# Email used for ACME (Let's Encrypt) registration and expiry notices.
ALCOVE_ACME_EMAIL=admin@example.com

# Storage backend: "local" (default, /data/files) or "s3".
ALCOVE_STORAGE=local
# Only when ALCOVE_STORAGE=s3
ALCOVE_S3_ENDPOINT=
ALCOVE_S3_REGION=
ALCOVE_S3_BUCKET=
ALCOVE_S3_ACCESS_KEY=
ALCOVE_S3_SECRET=
ALCOVE_S3_FORCE_PATH_STYLE=false

# Optional modules, comma separated. Names are validated, but no optional
# module is implemented yet, so this currently has no effect: ocr,faces
ALCOVE_MODULES=

# Header carrying the real client IP, set by the reverse proxy. docker-compose
# sets it to X-Forwarded-For. Leave empty if the server is reachable directly,
# otherwise clients could spoof their IP and bypass rate limiting.
# ALCOVE_TRUSTED_PROXY_HEADER=X-Forwarded-For

# Rate limits are enabled by default and tuned in the admin UI
# (https://<domain>/_/ → Settings → Rate limits).
