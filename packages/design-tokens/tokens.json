{
  "$description": "Single source of truth for Alcove's visual language. Run `pnpm build` after editing; never edit generated files.",
  "color": {
    "light": {
      "bg": "#F7F8FA",
      "surface": "#FFFFFF",
      "surfaceRaised": "#FFFFFF",
      "surfaceSunken": "#EEF0F3",
      "border": "#DCE0E5",
      "borderStrong": "#B9C0C9",
      "text": "#1A1D21",
      "textMuted": "#535C68",
      "accent": "#3E5C8A",
      "accentHover": "#334D75",
      "accentSubtle": "#E6ECF5",
      "accentContrast": "#FFFFFF",
      "success": "#1E7146",
      "warning": "#9A3F06",
      "danger": "#B42318",
      "dangerContrast": "#FFFFFF",
      "focus": "#3E5C8A",
      "overlay": "#1A1D2166",
      "stage": "#0B0C0E",
      "stagePanel": "#15171A",
      "stageBorder": "#2E333A",
      "onStage": "#E8EAED",
      "onStageMuted": "#A0A8B3",
      "onStageLink": "#93B2E0",
      "stageControl": "#FFFFFF1F",
      "stageScrim": "#00000099",
      "favorite": "#FF6B81"
    },
    "dark": {
      "bg": "#121417",
      "surface": "#1A1D21",
      "surfaceRaised": "#22262B",
      "surfaceSunken": "#0D0F11",
      "border": "#2E333A",
      "borderStrong": "#454C55",
      "text": "#E8EAED",
      "textMuted": "#A0A8B3",
      "accent": "#93B2E0",
      "accentHover": "#AFC6EA",
      "accentSubtle": "#22324A",
      "accentContrast": "#0F1A2B",
      "success": "#5BD394",
      "warning": "#FDB022",
      "danger": "#F97066",
      "dangerContrast": "#1A0B09",
      "focus": "#93B2E0",
      "overlay": "#000000A3",
      "stage": "#0B0C0E",
      "stagePanel": "#15171A",
      "stageBorder": "#2E333A",
      "onStage": "#E8EAED",
      "onStageMuted": "#A0A8B3",
      "onStageLink": "#93B2E0",
      "stageControl": "#FFFFFF1F",
      "stageScrim": "#00000099",
      "favorite": "#FF6B81"
    }
  },
  "font": {
    "family": {
      "sans": "Inter",
      "mono": "JetBrains Mono"
    },
    "fallback": {
      "sans": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
      "mono": "ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "size": { "xs": 12, "sm": 14, "md": 16, "lg": 18, "xl": 22, "2xl": 28, "3xl": 36 },
    "weight": { "regular": 400, "medium": 500, "semibold": 600 },
    "lineHeight": { "tight": 1.25, "normal": 1.5 }
  },
  "space": { "0": 0, "1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32, "7": 48, "8": 64 },
  "radius": { "sm": 6, "md": 10, "lg": 16, "full": 9999 },
  "shadow": {
    "light": {
      "sm": [{ "x": 0, "y": 1, "blur": 2, "spread": 0, "color": "#1A1D210F" }],
      "md": [{ "x": 0, "y": 4, "blur": 12, "spread": -2, "color": "#1A1D211A" }],
      "lg": [{ "x": 0, "y": 12, "blur": 32, "spread": -4, "color": "#1A1D2124" }]
    },
    "dark": {
      "sm": [{ "x": 0, "y": 1, "blur": 2, "spread": 0, "color": "#00000066" }],
      "md": [{ "x": 0, "y": 4, "blur": 12, "spread": -2, "color": "#00000080" }],
      "lg": [{ "x": 0, "y": 12, "blur": 32, "spread": -4, "color": "#00000099" }]
    }
  },
  "motion": {
    "duration": { "fast": 120, "base": 200, "slow": 320 },
    "easing": {
      "standard": [0.2, 0, 0, 1],
      "emphasized": [0.3, 0, 0, 1],
      "exit": [0.4, 0, 1, 1]
    }
  },
  "breakpoint": { "sm": 600, "md": 900, "lg": 1200 }
}
